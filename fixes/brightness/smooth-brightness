#!/usr/bin/python3 -I
"""smooth-brightness: gentle ambient-light screen brightness for GNOME.

Replaces GNOME's ambient brightness (set ambient-enabled=false). Reads lux from
iio-sensor-proxy, takes a 3 s median, waits for the light to settle, then does one
4 s fade via logind (no root). Manual brightness changes are learned
as a personal bias. Pauses while the session is idle so idle-dim is untouched.

Debug: SMOOTH_BRIGHTNESS_DEBUG=1
"""
import math
import statistics
from collections import deque
import os
import sys

import gi
gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

# ---- tunables -------------------------------------------------------------
SAMPLE_MS = 500           # sensor sample interval
MEDIAN_S = 3.0            # median window: drops flicker, settles fast (seconds)
SETTLE_S = 3              # light must hold steady this long before one fade
SETTLE_BAND_PCT = 3.0     # "steady" = target stays within this of the reference
DEADBAND_PCT = 6.0        # ignore target changes smaller than this (pct points)
FADE_S = 4.0              # duration of a brightness fade
FADE_STEP_MS = 50
MIN_PCT, MAX_PCT = 3.0, 100.0
IDLE_PAUSE_MS = 45_000    # stop adjusting/learning once idle this long
RESUME_GRACE_S = 8        # after idle ends, let GNOME restore, then resync
MANUAL_TOL_PCT = 2.0      # backlight differs from ours by more => manual change
MANUAL_MAX_IDLE_MS = 3000 # manual changes only count with input this recent
# ---------------------------------------------------------------------------

DEBUG = os.environ.get("SMOOTH_BRIGHTNESS_DEBUG") == "1"
BL_DIR = "/sys/class/backlight"


def log(*a):
    print(*a, flush=True)


def dbg(*a):
    if DEBUG:
        log(*a)


def find_backlight():
    names = sorted(os.listdir(BL_DIR))
    for pref in ("intel_backlight",):
        if pref in names:
            return pref
    if not names:
        sys.exit("no backlight device")
    return names[0]


class Smoother:
    def __init__(self):
        self.bl = find_backlight()
        self.max = int(open(f"{BL_DIR}/{self.bl}/max_brightness").read())
        self.sys = Gio.bus_get_sync(Gio.BusType.SYSTEM)
        self.ses = Gio.bus_get_sync(Gio.BusType.SESSION)
        self.sensor = Gio.DBusProxy.new_sync(
            self.sys, Gio.DBusProxyFlags.NONE, None, "net.hadess.SensorProxy",
            "/net/hadess/SensorProxy", "net.hadess.SensorProxy", None)
        self.sensor.call_sync("ClaimLight", None, Gio.DBusCallFlags.NONE, -1, None)
        self.log_lux = None       # median of recent log10(lux+1)
        self.hist = deque(maxlen=max(1, int(MEDIAN_S * 1000 / SAMPLE_MS)))
        self.bias = None          # multiplicative user preference
        self.ours = None          # last raw value we wrote
        self.fade = None          # (start, end, step, nsteps)
        self.was_idle = False
        self.grace_until = 0.0
        self.settle_ref = None
        self.settle_since = 0.0
        GLib.timeout_add(SAMPLE_MS, self.tick)

    # -- helpers --
    def now(self):
        return GLib.get_monotonic_time() / 1e6

    def actual(self):
        return int(open(f"{BL_DIR}/{self.bl}/actual_brightness").read())

    def pct(self, raw):
        return 100.0 * raw / self.max

    def raw(self, pct):
        return int(round(self.max * pct / 100.0))

    def write(self, raw):
        self.ours = raw
        try:
            self.sys.call_sync(
                "org.freedesktop.login1", "/org/freedesktop/login1/session/auto",
                "org.freedesktop.login1.Session", "SetBrightness",
                GLib.Variant("(ssu)", ("backlight", self.bl, raw)),
                None, Gio.DBusCallFlags.NONE, 2000, None)
        except GLib.Error as e:
            log("SetBrightness failed:", e.message)

    def idle_ms(self):
        try:
            r = self.ses.call_sync(
                "org.gnome.Mutter.IdleMonitor", "/org/gnome/Mutter/IdleMonitor/Core",
                "org.gnome.Mutter.IdleMonitor", "GetIdletime", None,
                GLib.VariantType("(t)"), Gio.DBusCallFlags.NONE, 1000, None)
            return r.unpack()[0]
        except GLib.Error:
            return 0

    def lux(self):
        v = self.sensor.get_cached_property("LightLevel")
        return max(0.0, v.unpack()) if v is not None else None

    @staticmethod
    def curve(log_lux):
        # ~44% at 15 lux, ~65% at 100, ~90% at 1000 lux (before bias)
        return 15.0 + 25.0 * log_lux

    def target_pct(self):
        return max(MIN_PCT, min(MAX_PCT, self.curve(self.log_lux) * self.bias))

    # -- main loop --
    def tick(self):
        lux = self.lux()
        if lux is None:
            return True
        ll = math.log10(lux + 1.0)
        self.hist.append(ll)
        self.log_lux = statistics.median(self.hist)

        cur = self.actual()
        t = self.now()

        if self.bias is None:  # adopt current level: no jump at startup
            if self.idle_ms() > MANUAL_MAX_IDLE_MS:
                return True  # might be idle-dimmed; wait for the user
            self.bias = self.pct(cur) / self.curve(self.log_lux)
            self.ours = cur
            log(f"start: lux={lux:.1f} level={self.pct(cur):.0f}% bias={self.bias:.2f}")
            return True

        idle_ms = self.idle_ms()
        changed = abs(self.pct(cur) - self.pct(self.ours)) > MANUAL_TOL_PCT
        # a change while the user isn't touching anything is GNOME idle-dim,
        # not a slider/key press (those always come with fresh input)
        dimmed = self.fade is None and changed and idle_ms > MANUAL_MAX_IDLE_MS
        if idle_ms >= IDLE_PAUSE_MS or dimmed or (self.was_idle and idle_ms > MANUAL_MAX_IDLE_MS) or cur == 0:
            if not self.was_idle:
                dbg("idle: pausing")
            self.was_idle = True
            self.fade = None
            return True
        if self.was_idle:
            self.was_idle = False
            self.grace_until = t + RESUME_GRACE_S
            dbg("resume: grace period")
        if t < self.grace_until:
            self.ours = cur
            return True

        # manual change (slider/keys) -> learn as bias
        if self.fade is None and changed:
            self.bias = self.pct(cur) / self.curve(self.log_lux)
            self.ours = cur
            log(f"manual change to {self.pct(cur):.0f}% -> bias={self.bias:.2f}")
            return True

        if self.fade is None:
            tgt = self.target_pct()
            # wait until the light has settled, so a big change is ONE fade
            if self.settle_ref is None or abs(tgt - self.settle_ref) > SETTLE_BAND_PCT:
                self.settle_ref, self.settle_since = tgt, t
                return True
            if t - self.settle_since < SETTLE_S:
                return True
            if abs(tgt - self.pct(cur)) >= DEADBAND_PCT:
                n = max(1, int(FADE_S * 1000 / FADE_STEP_MS))
                self.fade = [cur, self.raw(tgt), 0, n]
                dbg(f"fade {self.pct(cur):.0f}% -> {tgt:.0f}% (lux avg {10**self.log_lux - 1:.1f}, now {lux:.1f})")
                GLib.timeout_add(FADE_STEP_MS, self.fade_step)
        return True

    def fade_step(self):
        f = self.fade
        if f is None:
            return False
        # someone else changed it mid-fade -> abort, let tick() learn it
        if self.ours is not None and abs(self.pct(self.actual()) - self.pct(self.ours)) > MANUAL_TOL_PCT:
            self.fade = None
            return False
        f[2] += 1
        x = f[2] / f[3]
        x = x * x * (3 - 2 * x)  # smoothstep easing
        self.write(int(round(f[0] + (f[1] - f[0]) * x)))
        if f[2] >= f[3]:
            self.fade = None
            return False
        return True


if __name__ == "__main__":
    Smoother()
    GLib.MainLoop().run()
