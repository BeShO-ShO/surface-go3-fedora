#!/bin/sh
# Local fix (added 2026-11-14): the Surface Go 3 Type Cover touchpad (045e:09b5,
# interface 1.3, hid-multitouch) sometimes goes silent after boot or after a
# logout/login: the cover sends no touchpad reports at all (raw hidraw silent),
# while the keyboard keeps working. hid-multitouch sends mode-switch feature
# reports on every input close/open (mt_on_hid_hw_close/open) and the cover
# firmware doesn't complete them reliably (same cause as the suspend -EIO, see
# system-sleep/50-surface-typecover-touchpad), so the session -> greeter ->
# session handover can leave it stuck. Re-binding the driver does NOT wake it;
# a USB port reset (like a replug) does.
# Run at each login (wanted by user@.service): wait for the login screen to let go
# of the devices, then USB-reset the cover (keyboard drops out for ~2 s).
# To undo: systemctl disable surface-typecover-reprobe.service and delete it + this file.

# Wait (max 30 s) until the login screen session (class greeter) is gone; GDM's
# background 'manager-early' session lingers longer and doesn't hold the touchpad
greeter() {
    loginctl list-sessions --no-legend 2>/dev/null | awk '$3 == "gdm-greeter" && $6 == "greeter" { f = 1 } END { exit !f }'
}
i=0
while [ $i -lt 30 ] && greeter; do
    sleep 1; i=$((i + 1))
done
sleep 1

for d in /sys/bus/usb/devices/*; do
    [ "$(cat "$d/idVendor" 2>/dev/null):$(cat "$d/idProduct" 2>/dev/null)" = "045e:09b5" ] || continue
    b=$(printf '%03d/%03d' "$(cat "$d/busnum")" "$(cat "$d/devnum")")
    /usr/bin/usbreset "$b" >/dev/null && echo "USB-reset Type Cover $b"
    # 2026-11-16: on one boot the reset alone left the touchpad silent; a full
    # software replug (de-authorize + re-authorize = re-enumeration) revived it.
    sleep 1
    echo 0 > "$d/authorized" 2>/dev/null
    sleep 2
    # the cover may drop off the bus by itself meanwhile (it then comes back
    # already authorized), so retry for a few seconds instead of failing
    j=0
    while [ $j -lt 10 ]; do
        if [ "$(cat "$d/authorized" 2>/dev/null)" = 1 ] || echo 1 > "$d/authorized" 2>/dev/null; then
            echo "Re-enumerated Type Cover ${d##*/}"; break
        fi
        sleep 1; j=$((j + 1))
    done
done
exit 0
