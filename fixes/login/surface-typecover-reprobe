#!/bin/sh
# Local fix (added 2026-11-14): the Surface Go 3 Type Cover touchpad (045e:09b5,
# interface 1.3, hid-multitouch) sometimes goes silent after logout/login.
# hid-multitouch sends mode-switch feature reports on every input close/open
# (mt_on_hid_hw_close/open); the cover firmware doesn't complete them reliably
# (same cause as the suspend -EIO, see system-sleep/50-surface-typecover-touchpad),
# so the session -> greeter -> session handover can leave it reporting nothing.
# Run at each login (wanted by user@.service): wait for the login screen to let go
# of the devices, then re-probe the touchpad interface (unbind + bind usbhid).
# To undo: systemctl disable surface-typecover-reprobe.service and delete it + this file.
DRV=/sys/bus/usb/drivers/usbhid

# Wait (max 30 s) until the login screen session (class greeter) is gone; GDM's
# background 'manager-early' session lingers longer and doesn't hold the touchpad
greeter() {
    loginctl list-sessions --no-legend 2>/dev/null | awk '$3 == "gdm-greeter" && $6 == "greeter" { f = 1 } END { exit !f }'
}
i=0
while [ $i -lt 30 ] && greeter; do
    sleep 1; i=$((i + 1))
done
sleep 1

for p in /sys/bus/usb/devices/*:1.3; do
    [ -e "$p" ] || continue
    d=${p%:1.3}
    [ "$(cat "$d/idVendor" 2>/dev/null):$(cat "$d/idProduct" 2>/dev/null)" = "045e:09b5" ] || continue
    n=$(basename "$p")
    [ -e "$p/driver" ] && echo "$n" > "$DRV/unbind"
    sleep 0.3
    echo "$n" > "$DRV/bind" && echo "re-probed Type Cover touchpad $n"
done
exit 0
